{
  "name": "@linkup/mobile-design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Link-Up B2C Mobile Web / PWA Design System & AI Agent Skill",
  "repository": {
    "type": "git",
    "url": "https://github.com/Link-up-co/mobile-design-system.git"
  },
  "homepage": "https://link-up-co.github.io/mobile-design-system/",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./styles.css": "./src/styles/theme.css"
  },
  "bin": {
    "linkup-mds": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "src/mobile",
    "src/tokens",
    "src/styles",
    "skills",
    "bin",
    "DESIGN.md",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3420",
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true next build",
    "build:pkg": "node scripts/build-pkg.mjs",
    "prepublishOnly": "npm run build:pkg",
    "start": "next start -p 3420",
    "test": "tsx --test tests/*.test.*",
    "typecheck": "tsc --noEmit",
    "check": "npm run build:pkg && npm test && npm run typecheck"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "next": "^16.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
